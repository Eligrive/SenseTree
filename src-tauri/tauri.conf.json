{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sensetree",
  "version": "1.3.3",
  "identifier": "com.virgi.sensetree",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SenseTree",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Eligrive/SenseTree/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2RjJERjkyNEQ3MDJCRkIKUldUN0szQk5rdC95Wmp4QTFSRmRSUlNCbEkxTVpSNldSSVgxZ0l2L1Irc3EvanJQbmRFL0pWeDAK"
    }
  }
}
